	$(AM_V_at)$(am__mv) $(DEPDIR)/libwifi_webconfig_la-wifi_webconfig.Tpo $(DEPDIR)/libwifi_webconfig_la-wifi_webconfig.Plo
#	$(AM_V_CC)source='wifi_webconfig.c' object='libwifi_webconfig_la-wifi_webconfig.lo' libtool=yes \
#	DEPDIR=$(DEPDIR) $(CCDEPMODE) $(depcomp) \
